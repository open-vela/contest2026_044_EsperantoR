{
  "package": "com.application.watch.sport_coach",
  "name": "动感教练",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.storage" },
    { "name": "service.health" },
    { "name": "system.sensor" },
    { "name": "system.vibrator" },
    { "name": "system.bluetooth" }
  ],
  "permissions": [
    { "name": "hapjs.permission.HEALTH" },
    { "name": "hapjs.permission.BLUETOOTH" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "device-width",
    "background": {
      "features": ["service.health"]
    }
  },
  "router": {
    "entry": "pages/clock",
    "pages": {
      "pages/clock": { "component": "clock" },
      "pages/exercise_select": { "component": "exercise_select" },
      "pages/exercise_list": { "component": "exercise_list" },
      "pages/exercise_active": { "component": "exercise_active" },
      "pages/ai_result": { "component": "ai_result" },
      "pages/history": { "component": "history" },
      "pages/compass": { "component": "compass" },
      "pages/altitude": { "component": "altitude" },
      "pages/timer": { "component": "timer" },
      "pages/music": { "component": "music" },
      "pages/health": { "component": "health" },
      "pages/weather": { "component": "weather" },
      "pages/settings": { "component": "settings" },
      "pages/xiaozhi": { "component": "xiaozhi" },
      "pages/control_center": { "component": "control_center" }
    }
  }
}
