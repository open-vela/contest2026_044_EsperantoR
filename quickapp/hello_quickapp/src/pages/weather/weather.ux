.advice-title { color: #00E676; font-size: 13px; font-weight: bold; margin-bottom: 4px; }
.advice-text { color: #aaa; font-size: 12px; line-height: 16px; }

.forecast-section { width: 100%; padding: 10px; background-color: #111; border-radius: 10px; margin-bottom: 10px; }
.forecast-title { color: #888; font-size: 12px; margin-bottom: 8px; }
.forecast-list { flex-direction: row; justify-content: space-around; }
.forecast-item { flex-direction: column; align-items: center; }
.forecast-time { color: #888; font-size: 11px; margin-bottom: 4px; }
