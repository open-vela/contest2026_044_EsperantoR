<template>
  <div class="container">
    <nav-bar title="计时器"></nav-bar>
    <div class="content">
      <div class="mode-tabs">
        <div class="tab {{ mode === 'stopwatch' ? 'tab-active' : '' }}" onclick="onModeStopwatch">
          <text class="tab-text tab-text-active">秒表</text>
        </div>
        <div class="tab {{ mode === 'countdown' ? 'tab-active' : '' }}" onclick="onModeCountdown">
          <text class="tab-text tab-text-active">倒计时</text>
        </div>
      </div>
      <text class="time-display">{{ displayTime }}</text>
      <div class="controls">
        <div class="ctrl-btn" onclick="onStart">
          <text class="ctrl-text">{{ running ? '暂停' : '开始' }}</text>
        </div>
        <div class="ctrl-btn ctrl-btn-reset" onclick="onReset">
          <text class="ctrl-text ctrl-text-light">重置</text>
        </div>
      </div>
    </div>
    <div class="bottom-hint">
      <text class="swipe-hint">双右滑返‹</text>
    </div>
    <div class="exit-hint" if="{{ showExitHint }}">
      <text class="exit-hint-text">再滑一次退出</text>
    </div>
  </div>
</template>

<script>
var logger = require('../../common/logger.js');
import NavBar from '../../components/nav-bar.ux';

export default {
  components: { NavBar },
  private: {
    mode: 'stopwatch',
    displayTime: '00:00',
    running: false,
    seconds: 0,
    showExitHint: false,
    _lastSwipeTime: 0,
    _timer: null
  },
  onReady() { logger.info('timer page ready'); },
  onDestroy() { this.stopTimer(); },
  onModeStopwatch() { this.mode = 'stopwatch'; this.reset(); },
  onModeCountdown() { this.mode = 'countdown'; this.reset(); this.seconds = 300; this.updateDisplay(); },
  onStart() {
    if (this.running) { this.stopTimer(); this.running = false; }
    else { this.startTimer(); this.running = true; }
  },
  onReset() { this.stopTimer(); this.running = false; this.seconds = this.mode === 'countdown' ? 300 : 0; this.updateDisplay(); },
  startTimer() {
    var self = this;
    this._timer = setInterval(function() {
      if (self.mode === 'stopwatch') { self.seconds++; }
      else { self.seconds--; if (self.seconds <= 0) { self.stopTimer(); self.running = false; self.seconds = 0; } }
      self.updateDisplay();
    }, 1000);
  },
  stopTimer() { if (this._timer) { clearInterval(this._timer); this._timer = null; } },
  reset() { this.stopTimer(); this.running = false; this.seconds = this.mode === 'countdown' ? 300 : 0; this.updateDisplay(); },
  updateDisplay() {
    var m = Math.floor(Math.abs(this.seconds) / 60);
    var s = Math.abs(this.seconds) % 60;
    this.displayTime = (m < 10 ? '0' + m : '' + m) + ':' + (s < 10 ? '0' + s : '' + s);
  },
  onPageSwipe(evt) {
    var now = Date.now();
    if (evt.direction === 'right') {
      if (now - this._lastSwipeTime < 500) { require('@system.router').back(); return; }
      this._lastSwipeTime = now; this.showExitHint = true;
      var self = this; setTimeout(function() { self.showExitHint = false; }, 1000);
    }
  }
}
</script>

<style>
.container { width: 100%; height: 100%; background-color: #000; flex-direction: column; align-items: center; padding: 40px 24px; border-radius: 230px; }
.content { flex: 1; flex-direction: column; align-items: center; justify-content: center; width: 100%; }
.mode-tabs { flex-direction: row; margin-bottom: 20px; }
.tab { padding: 8px 20px; background-color: #222; border-radius: 20px; margin: 0px 6px; }
.tab-active { background-color: #00E676; }
.tab-text { color: #fff; font-size: 14px; }
.tab-text-active { color: #000; }
.time-display { color: #fff; font-size: 56px; font-weight: bold; margin-bottom: 24px; }
.controls { flex-direction: row; }
.ctrl-btn { padding: 12px 28px; background-color: #00E676; border-radius: 230px; margin: 0px 8px; }
.ctrl-btn-reset { background-color: #333; }
.ctrl-text { color: #000; font-size: 16px; font-weight: bold; }
.ctrl-text-light { color: #fff; }
.bottom-hint { align-items: center; margin-top: auto; }
.swipe-hint { color: #666; font-size: 12px; }
.exit-hint { position: fixed; bottom: 60px; left: 0; width: 100%; align-items: center; }
.exit-hint-text { background-color: rgba(255,38,60,0.8); color: #fff; font-size: 12px; padding: 6px 16px; border-radius: 12px; }
</style>
