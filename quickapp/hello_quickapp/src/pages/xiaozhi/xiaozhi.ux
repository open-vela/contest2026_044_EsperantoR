  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  padding: 40px 24px 24px 24px;
  border-radius: 50%;
}

.status-area {
  flex-direction: column;
  align-items: center;
  margin-bottom: 24px;
  padding: 16px;
  background-color: #1a1a1a;
  border-radius: 16px;
  width: 100%;
}

.status-indicator {
  flex-direction: row;
  align-items: center;
}

.status-dot {
  font-size: 18px;
  margin-right: 8px;
}

.status-text {
  color: #ffffff;
  font-size: 18px;
  font-weight: bold;
}

.device-name {
  color: #888888;
  font-size: 14px;
  margin-top: 6px;
}

.feature-list {
  flex-direction: column;
  width: 100%;
  flex: 1;
}

.feature-item {
  flex-direction: row;
  align-items: center;
  padding: 14px 16px;
  margin-bottom: 10px;
  background-color: #1a1a1a;
  border-radius: 12px;
  border-width: 1px;
  border-color: #333333;
}

.feature-icon {
  font-size: 24px;
  margin-right: 12px;
}

.feature-name {
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
  flex: 1;
}

.feature-desc {
  color: #888888;
  font-size: 12px;
}

.help-section {
  flex-direction: column;
  width: 100%;
  padding: 16px;
  background-color: #111111;
  border-radius: 12px;
  margin-top: 10px;
}

.help-title {
  color: #FFD700;
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 8px;
}

.help-text {
  color: #888888;
  font-size: 13px;
  margin-bottom: 4px;
}

.bottom-hint {
  align-items: center;
  margin-top: auto;
}

.swipe-hint {
  color: #666666;
  font-size: 14px;
}
</style>
