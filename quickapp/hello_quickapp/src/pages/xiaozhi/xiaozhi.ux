<template>
  <div class="container">
    <!-- 标题 -->
    <nav-bar title="小智AI"></nav-bar>

    <!-- 连接状态 -->
    <div class="status-area">
      <div class="status-indicator">
        <text class="status-dot" style="color: {{ isConnected ? '#00E676' : '#FF263C' }}">●</text>
        <text class="status-text">{{ isConnected ? '已连接' : '未连接' }}</text>
      </div>
      <text class="device-name" if="{{ isConnected }}">{{ deviceName }}</text>
    </div>

    <!-- 功能区域 -->
    <div class="feature-list">
      <div class="feature-item" onclick="onConnectBLE">
        <text class="feature-icon">📶</text>
        <text class="feature-name">{{ isConnected ? '断开连接' : '连接蓝牙' }}</text>
        <text class="feature-desc">{{ isConnected ? '点击断开BLE连接' : '点击连接小智AI设备' }}</text>
      </div>

      <div class="feature-item" onclick="onActivateDevice" if="{{ isConnected && !isActivated }}">
        <text class="feature-icon">🔑</text>
        <text class="feature-name">激活设备</text>
        <text class="feature-desc">前往 xiaozhi.me 输入设备码</text>
      </div>

      <div class="feature-item" onclick="onVoiceChat" if="{{ isConnected && isActivated }}">
        <text class="feature-icon">🎤</text>
        <text class="feature-name">语音对话</text>
        <text class="feature-desc">按KEY2开始语音交互</text>
      </div>

      <div class="feature-item" onclick="onViewHistory" if="{{ isConnected && isActivated }}">
        <text class="feature-icon">💬</text>
        <text class="feature-name">对话历史</text>
        <text class="feature-desc">查看与小智的对话记录</text>
      </div>
    </div>

    <!-- 使用说明 -->
    <div class="help-section" if="{{ !isConnected }}">
      <text class="help-title">使用说明</text>
      <text class="help-text">1. 打开手机蓝牙网络共享</text>
      <text class="help-text">2. 点击"连接蓝牙"配对设备</text>
      <text class="help-text">3. 连接后访问 xiaozhi.me 激活</text>
      <text class="help-text">4. 使用KEY2按钮进行语音对话</text>
    </div>

    <!-- 底部提示 -->
    <div class="bottom-hint">
      <text class="swipe-hint">右滑返回</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router';

var bleService = require('../../common/bleService.js');
var gestureRouter = require('../../common/gestureRouter.js');
var logger = require('../../common/logger.js');
import NavBar from '../../components/nav-bar.ux';

export default {
  components: { NavBar },
  private: {
    isConnected: false,
    isActivated: false,
    deviceName: '',
    showExitHint: false,
    _statusTimer: null,
    _lastSwipeTime: 0
  },

  onReady() {
    logger.info('xiaozhi page ready');
    gestureRouter.setCurrentPage('pages/xiaozhi');
    this.updateStatus();
    this.startStatusPolling();
  },

  onDestroy() {
    this.stopStatusPolling();
  },

  startStatusPolling() {
    var self = this;
    this._statusTimer = setInterval(function() {
      self.updateStatus();
    }, 2000);
  },

  stopStatusPolling() {
    if (this._statusTimer) {
      clearInterval(this._statusTimer);
      this._statusTimer = null;
    }
  },

  updateStatus() {
    this.isConnected = bleService.isConnected();
    if (this.isConnected) {
      this.deviceName = bleService.getDeviceId() || 'sifli-pan';
    }
  },

  onConnectBLE() {
    var self = this;
    if (this.isConnected) {
      bleService.disconnect();
      this.isConnected = false;
      this.deviceName = '';
      logger.info('BLE已断开');
    } else {
      logger.info('开始连接BLE...');
      bleService.connect('sifli-pan').then(function() {
        self.isConnected = true;
        self.deviceName = 'sifli-pan';
        logger.info('BLE连接成功');
      }).catch(function(err) {
        logger.error('BLE连接失败: ' + err.message);
        self.isConnected = false;
      });
    }
  },

  onActivateDevice() {
    // 显示激活提示
    logger.info('请访问 xiaozhi.me 激活设备');
  },

  onVoiceChat() {
    // 触发语音对话
    logger.info('开始语音对话...');
    if (bleService.isConnected()) {
      bleService.simulateAIResponse();
    }
  },

  onViewHistory() {
    router.push({ uri: '/pages/history' });
  },

  onPageSwipe(evt) {
    var now = Date.now();
    if (evt.direction === 'right') {
      if (now - this._lastSwipeTime < 500) {
        router.back();
        return;
      }
      this._lastSwipeTime = now;
      this.showExitHint = true;
      var self = this;
      setTimeout(function() { self.showExitHint = false; }, 1000);
    }
  }
}
</script>

