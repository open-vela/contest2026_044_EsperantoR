  background-color: #000000;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px 20px 20px;
  border-radius: 230px;
}

.exercise-list {
  flex-direction: column;
  width: 100%;
  flex: 1;
}

.exercise-item {
  flex-direction: row;
  align-items: center;
  padding: 14px 16px;
  margin-bottom: 8px;
  background-color: #111111;
  border-radius: 14px;
  border-width: 1px;
  border-color: #222222;
}

.exercise-icon {
  font-size: 28px;
  margin-right: 14px;
}

.exercise-info {
  flex: 1;
  flex-direction: column;
}

.exercise-name {
  color: #ffffff;
  font-size: 18px;
  font-weight: bold;
}

.exercise-detail {
  color: #888888;
  font-size: 12px;
  margin-top: 2px;
}

.exercise-arrow {
  color: #666666;
  font-size: 20px;
}

.bottom-hint {
  align-items: center;
  margin-top: auto;
}

.swipe-hint {
  color: #666666;
  font-size: 12px;
}

.exit-hint {
  position: fixed;
  bottom: 60px;
  left: 0;
  width: 100%;
  align-items: center;
}

.exit-hint-text {
  background-color: rgba(255, 38, 60, 0.8);
  color: #ffffff;
  font-size: 12px;
  padding: 6px 16px;
  border-radius: 12px;
}
</style>
