<template>
  <div class="container">
    <nav-bar title="选择运动"></nav-bar>

    <div class="exercise-list">
      <div class="exercise-item" for="{{ exercises }}" onclick="onSelect($idx)">
        <text class="exercise-icon">{{ $item.icon }}</text>
        <div class="exercise-info">
          <text class="exercise-name">{{ $item.name }}</text>
          <text class="exercise-detail">{{ $item.detail }}</text>
        </div>
        <text class="exercise-arrow">‹</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router';

var utils = require('../../common/utils.js');
var logger = require('../../common/logger.js');
import NavBar from '../../components/nav-bar.ux';

export default {
  components: { NavBar },
  private: {
    exercises: [],
    showExitHint: false,
    _lastSwipeTime: 0
  },

  onReady() {
    logger.info('exercise_list page ready');
    var types = utils.getAllExerciseTypes();
    var details = {
      squat: '15次/组 × 3组',
      pushup: '12次/组 × 3组',
      jumping_jack: '20次/组 × 3组',
      high_knee: '30次/组 × 3组',
      running: '自由跑步'
    };
    for (var i = 0; i < types.length; i++) {
      types[i].detail = details[types[i].key] || '';
    }
    this.exercises = types;
  },

  onSelect(index) {
    var item = this.exercises[index];
    if (item) {
      router.push({
        uri: '/pages/exercise_active',
        params: { exerciseType: item.key }
      });
    }
  }
}
</script>

