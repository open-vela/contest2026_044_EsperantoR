<template>
  <div class="container">
    <nav-bar title="系统设置"></nav-bar>

    <div class="settings-list">
      <div class="settings-group">
        <text class="group-title">显示</text>
        <div class="setting-item" onclick="onBrightness">
          <text class="setting-icon">☀�?/text>
          <text class="setting-name">屏幕亮度</text>
          <text class="setting-value">{{ brightness }}%</text>
        </div>
        <div class="setting-item" onclick="onAutoLock">
          <text class="setting-icon">🔒</text>
          <text class="setting-name">自动锁屏</text>
          <text class="setting-value">{{ autoLockText }}</text>
        </div>
      </div>

      <div class="settings-group">
        <text class="group-title">运动</text>
        <div class="setting-item" onclick="onRestDuration">
          <text class="setting-icon">⏱️</text>
          <text class="setting-name">组间休息时间</text>
          <text class="setting-value">{{ restDuration }}�?/text>
        </div>
        <div class="setting-item" onclick="onVibrate">
          <text class="setting-icon">📳</text>
          <text class="setting-name">振动反馈</text>
          <text class="setting-value">{{ vibrateEnabled ? '开�? : '关闭' }}</text>
        </div>
        <div class="setting-item" onclick="onVoiceGuide">
          <text class="setting-icon">🔊</text>
          <text class="setting-name">语音播报</text>
          <text class="setting-value">{{ voiceEnabled ? '开�? : '关闭' }}</text>
        </div>
      </div>

      <div class="settings-group">
        <text class="group-title">连接</text>
        <div class="setting-item" onclick="onBluetooth">
          <text class="setting-icon">📶</text>
          <text class="setting-name">蓝牙</text>
          <text class="setting-value" style="color: {{ bleConnected ? '#00E676' : '#888' }}">{{ bleConnected ? '已连�? : '未连�? }}</text>
        </div>
        <div class="setting-item" onclick="onXiaozhi">
          <text class="setting-icon">🤖</text>
          <text class="setting-name">小智AI</text>
          <text class="setting-value">{{ xiaozhiStatus }}</text>
        </div>
      </div>

      <div class="settings-group">
        <text class="group-title">关于</text>
        <div class="setting-item">
          <text class="setting-icon">📱</text>
          <text class="setting-name">应用版本</text>
          <text class="setting-value">v1.0.0</text>
        </div>
        <div class="setting-item">
          <text class="setting-icon">ℹ️</text>
          <text class="setting-name">设备信息</text>
          <text class="setting-value">SF32LB52</text>
        </div>
      </div>
    </div>

    <div class="bottom-hint">
      <text class="swipe-hint">双右滑返�?/text>
    </div>
    <div class="exit-hint" if="{{ showExitHint }}">
      <text class="exit-hint-text">再滑一次退�?/text>
    </div>
  </div>
</template>

<script>
var logger = require('../../common/logger.js');
var bleService = require('../../common/bleService.js');
import NavBar from '../../components/nav-bar.ux';

export default {
  components: { NavBar },
  private: {
    brightness: 80,
    autoLock: 2,
    autoLockText: '2分钟',
    restDuration: 30,
    vibrateEnabled: true,
    voiceEnabled: false,
    bleConnected: false,
    xiaozhiStatus: '未配�?,
    showExitHint: false,
    _lastSwipeTime: 0
  },

  onReady() {
    logger.info('settings page ready');
    this.loadSettings();
  },

  loadSettings() {
    this.bleConnected = bleService.isConnected();
    if (this.bleConnected) {
      this.xiaozhiStatus = '已连�?;
    }
  },

  onBrightness() {
    this.brightness = this.brightness >= 100 ? 20 : this.brightness + 20;
    logger.info('亮度设置: ' + this.brightness + '%');
  },

  onAutoLock() {
    var options = [1, 2, 5, 10];
    var texts = ['1分钟', '2分钟', '5分钟', '10分钟'];
    var idx = options.indexOf(this.autoLock);
    idx = (idx + 1) % options.length;
    this.autoLock = options[idx];
    this.autoLockText = texts[idx];
    logger.info('自动锁屏: ' + this.autoLockText);
  },

  onRestDuration() {
    var options = [15, 30, 45, 60];
    var idx = options.indexOf(this.restDuration);
    idx = (idx + 1) % options.length;
    this.restDuration = options[idx];
    logger.info('组间休息: ' + this.restDuration + '�?);
  },

  onVibrate() {
    this.vibrateEnabled = !this.vibrateEnabled;
    logger.info('振动反馈: ' + (this.vibrateEnabled ? '开�? : '关闭'));
  },

  onVoiceGuide() {
    this.voiceEnabled = !this.voiceEnabled;
    logger.info('语音播报: ' + (this.voiceEnabled ? '开�? : '关闭'));
  },

  onBluetooth() {
    var self = this;
    if (this.bleConnected) {
      bleService.disconnect();
      this.bleConnected = false;
      this.xiaozhiStatus = '未配�?;
    } else {
      bleService.connect('sifli-pan').then(function() {
        self.bleConnected = true;
        self.xiaozhiStatus = '已连�?;
      }).catch(function() {
        self.bleConnected = false;
        self.xiaozhiStatus = '连接失败';
      });
    }
  },

  onXiaozhi() {
    require('@system.router').push({ uri: '/pages/xiaozhi' });
  },

  onPageSwipe(evt) {
    var now = Date.now();
    if (evt.direction === 'right') {
      if (now - this._lastSwipeTime < 500) {
        require('@system.router').back();
        return;
      }
      this._lastSwipeTime = now;
      this.showExitHint = true;
      var self = this;
      setTimeout(function() { self.showExitHint = false; }, 1000);
    }
  }
}
</script>

<style>
.container { width: 100%; height: 100%; background-color: #000; flex-direction: column; align-items: center; padding: 36px 16px 16px 16px; border-radius: 230px; }

.settings-list { flex-direction: column; width: 100%; flex: 1; }
.settings-group { margin-bottom: 10px; }
.group-title { color: #888; font-size: 11px; margin-bottom: 4px; margin-left: 4px; }

.setting-item { flex-direction: row; align-items: center; padding: 10px 12px; margin-bottom: 3px; background-color: #111; border-radius: 10px; }
.setting-icon { font-size: 16px; margin-right: 10px; }
.setting-name { color: #fff; font-size: 13px; flex: 1; }
.setting-value { color: #888; font-size: 12px; }

.bottom-hint { align-items: center; margin-top: auto; }
.swipe-hint { color: #666; font-size: 11px; }
.exit-hint { position: fixed; bottom: 50px; left: 0; width: 100%; align-items: center; }
.exit-hint-text { background-color: rgba(255,38,60,0.8); color: #fff; font-size: 11px; padding: 5px 14px; border-radius: 10px; }
</style>
